<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CS2Browser.IdlGenerator</RootNamespace>
    <AssemblyName>CS2Browser.IdlGenerator</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Definitions\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
